# Copy to .env.local for development. Never commit a filled-in copy.

# ---------------------------------------------------------------- app ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------ supabase ----
# Project settings -> API. The service role key bypasses RLS: server only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------ anthropic ----
ANTHROPIC_API_KEY=

# Model tiers. Nothing in the code hard-codes a model name.
#   AI_MODEL       -- receptionist and the reasoning agents (Atlas, Mercury, Nova)
#   AI_MODEL_FAST  -- classification and extraction (Sentinel, Forge)
# Both default to claude-opus-5. To trade quality for cost on the high-volume
# path, set AI_MODEL_FAST to a cheaper model. See docs/COST_CONTROL.md for the
# price table before changing this.
AI_MODEL=claude-opus-5
AI_MODEL_FAST=claude-opus-5

# Set to "mock" for offline local development. Refused in production.
# AI_PROVIDER=mock

# --------------------------------------------------------------- twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --------------------------------------------------------------- stripe ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs from your Stripe products. Pricing is never hard-coded.
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ---------------------------------------------------------------- email ----
# Not used by the MVP -- notifications go by SMS. Present so adding email later
# needs no env change. Leave blank.
RESEND_API_KEY=

# ------------------------------------------------- platform kill switches ----
# Omit for enabled. Set to "false" to disable platform-wide.
# AI_ENABLED=true
# VOICE_ENABLED=true
# SMS_ENABLED=true
# BOOKING_ENABLED=true
# OUTBOUND_FOLLOWUP_ENABLED=true
# PROSPECTING_ENABLED=true
