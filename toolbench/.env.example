# Public site URL. Used for canonicals, sitemap and OpenGraph.
# Must be the real production host or SEO tags point at a placeholder.
NEXT_PUBLIC_SITE_URL=https://toolbench.app

# REQUIRED IN PRODUCTION. Protects /admin via HTTP Basic auth.
# When unset, /admin returns 503 rather than exposing the dashboard —
# it fails closed on purpose. Any username works; only the password is checked.
ADMIN_PASSWORD=

# Optional. When absent, analytics counts live in memory and reset on restart,
# which is fine for local work and for a first deploy. Set it to persist.
# DATABASE_URL=postgresql://...
