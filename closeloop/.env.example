# ---------------------------------------------------------------------------
# Closeloop configuration. Copy to .env and fill in. NEVER commit .env.
# Every value below has a safe default; the app runs with none of them set.
# ---------------------------------------------------------------------------

# HTTP
PORT=3000
BASE_URL=http://localhost:3000

# Operator login for /admin. CHANGE THIS before exposing the app publicly.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-now

# Signing secret for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# -------------------- AUTOMATION MODE (GLOBAL KILL SWITCH) -----------------
# OFF      - engine does not run at all
# TEST     - messages are rendered and logged, never sent. DEFAULT.
# ASSISTED - messages queue for human approval, send only once approved
# LIVE     - messages send automatically to real recipients
# The global mode is a CEILING. A client can be more restrictive, never less.
AUTOMATION_MODE=TEST

# -------------------- PROVIDERS --------------------------------------------
# Leave as "mock" until you have credentials AND have authorized spend.
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
AI_PROVIDER=mock

# Twilio (SMS) - PAID. ~$1.15/mo per number + ~$0.0079 per SMS segment.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP (email) - free tiers exist (e.g. Resend 3k/mo, Brevo 300/day)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Anthropic (AI lead classification + message drafting) - PAID per token.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Shared secret required on inbound webhooks (/webhooks/*)
WEBHOOK_SECRET=
