# ---- Database -------------------------------------------------------------
DATABASE_URL="postgresql://buildsight:buildsight@localhost:5432/buildsight?schema=public"

# ---- Auth -----------------------------------------------------------------
# 32+ byte random string: `openssl rand -base64 48`
AUTH_SECRET="change-me-in-production-min-32-characters-long"
# Optional: bootstrap the first admin account by email on seed
ADMIN_EMAIL="admin@buildsight.local"
ADMIN_PASSWORD="admin12345"

# ---- SCOPE assistant (optional) -------------------------------------------
# When unset, SCOPE falls back to the deterministic local intent parser.
# The LLM is only ever used to translate natural language into structured
# filters. It never determines technical compatibility.
ANTHROPIC_API_KEY=""
SCOPE_MODEL="claude-sonnet-5"

# ---- Stripe (optional) ----------------------------------------------------
# When unset, billing runs in "simulation" mode: plans are selectable locally
# but no charge is attempted.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PRO_PLUS=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Notifications (optional) ---------------------------------------------
# Without these the app records notifications in-app and logs the email that
# would have been sent.
EMAIL_API_KEY=""
EMAIL_FROM="BuildSight <notifications@buildsight.example>"

# ---- Scheduled jobs -------------------------------------------------------
# Shared secret for POST /api/jobs/price-check (header: x-job-token).
JOBS_TOKEN=""

# ---- Testing --------------------------------------------------------------
# Integration tests run against this database. Leave empty to skip them.
TEST_DATABASE_URL="postgresql://buildsight:buildsight@localhost:5432/buildsight_test?schema=public"
