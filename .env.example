# ---------------------------------------------------------------------------
# YouTube Clip Generator - configuration
# Copy to .env and edit. Every value below is optional; these are the defaults.
# ---------------------------------------------------------------------------

# --- Storage ---------------------------------------------------------------
# Where the SQLite database lives.
DATABASE_URL=sqlite:///./storage/clipgen.db
# Finished clips, thumbnails and job metadata.
OUTPUT_DIRECTORY=./storage/jobs
# Scratch space for downloaded source media (deleted after rendering).
TEMP_DIRECTORY=./temp

# --- Limits ----------------------------------------------------------------
# Refuse source videos longer than this (seconds). Default 3 hours.
MAX_VIDEO_DURATION=10800
# Refuse source videos shorter than this (seconds) - too short to clip.
MIN_VIDEO_DURATION=90
# How many jobs may render at the same time.
MAX_CONCURRENT_JOBS=2
# Delete finished jobs (and their clips) after this many hours.
JOB_TTL_HOURS=24
# Hard ceiling on any single ffmpeg/yt-dlp subprocess, in seconds.
SUBPROCESS_TIMEOUT=3600
# Minimum free disk space required before a job starts, in MB.
MIN_FREE_DISK_MB=2048

# --- Clip defaults ---------------------------------------------------------
MIN_CLIP_SECONDS=30
MAX_CLIP_SECONDS=60
TARGET_CLIP_SECONDS=52
MIN_CLIPS=5
MAX_CLIPS=8

# --- Encoding --------------------------------------------------------------
# x264 constant rate factor. Lower = better quality + bigger files. 18 is
# visually near-lossless.
VIDEO_CRF=18
# x264 speed/efficiency tradeoff: ultrafast..veryslow
VIDEO_PRESET=medium
AUDIO_BITRATE=192k
# Set to 1 to use NVENC/QSV/VideoToolbox when detected. Off by default because
# software x264 produces better quality at the same file size.
PREFER_HARDWARE_ENCODER=0

# --- YouTube access --------------------------------------------------------
# YouTube increasingly asks downloaders to "confirm you're not a bot". The
# supported fix is to present a browser session you are already signed in to.
# This does not bypass anything - a video you can't watch signed in is still
# refused. Set to a browser name, optionally with a profile:
#   chrome | firefox | safari | edge | brave | chromium | opera | vivaldi
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FROM_BROWSER=firefox:my-profile

# Alternatively point at an exported cookies.txt file.
# YTDLP_COOKIES_FILE=/path/to/cookies.txt

# Route yt-dlp through a proxy (useful on a locked-down network).
# YTDLP_PROXY=http://127.0.0.1:8080

# --- Uploads ---------------------------------------------------------------
# Largest video file accepted through the "use a video file" route, in MB.
MAX_UPLOAD_MB=2048

# --- Speech to text --------------------------------------------------------
# tiny | base | small | medium  (larger = more accurate, much slower)
WHISPER_MODEL=base
# Set to 0 to disable the local Whisper fallback entirely.
WHISPER_ENABLED=1

# --- Optional AI ranking ---------------------------------------------------
# Entirely optional. Without a key the app uses its own heuristic scorer,
# which is the default path and works fine.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_RANKING_ENABLED=0

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
