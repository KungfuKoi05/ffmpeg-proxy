# Copy to .env and fill in. .env is gitignored and must never be committed.
# Nothing here is required until the business is validated and the founder authorizes it.

# Optional: transcription/AI provider key, if fulfillment ever needs one beyond Claude Code
# ANTHROPIC_API_KEY=

# Optional: Stripe payment link secret, only if programmatic invoicing is ever needed
# STRIPE_SECRET_KEY=

# Optional: SMTP credentials, ONLY if the founder later authorizes automated sending.
# The system does not send outreach by default - it produces drafts the founder sends.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
